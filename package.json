{
  "name": "js-app-template",
  "version": "1.0.0",
  "description": "Webpack Vanilla JS Starter Template",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack.config.cjs --open",
    "build": "webpack --config webpack.config.cjs",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "deploy": "npm run build && git push origin --delete gh-pages 2>/dev/null; git subtree push --prefix dist origin gh-pages"
  },
  "devDependencies": {
    "css-loader": "^6.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "html-webpack-plugin": "^5.6.0",
    "prettier": "^3.2.5",
    "style-loader": "^3.3.4",
    "webpack": "^5.109.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  }
}
